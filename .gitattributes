# Patches and overlay files are Postgres-side content: they reach the build byte for byte, line endings
# included (`patches:check` proves patches/ round-trips exactly), so git must never convert them.
/patches/** -text
/overlay/** -text
/tests/fixtures/** binary
# The pg_regress baseline's diffs are compared byte for byte with a run's (bun run regress).
/regress/diffs/** -text
