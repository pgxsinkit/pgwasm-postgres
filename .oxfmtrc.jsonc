{
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": true,
  },
  "sortPackageJson": {
    "sortScripts": true,
  },
  // overlay/ and patches/ are Postgres-side content carried byte for byte (tree identity); docs/adr/ is
  // immutable once accepted. .cache/ and work/ hold the upstream clone and its worktrees.
  "ignorePatterns": [".cache/**", "docs/adr/**", "node_modules/**", "overlay/**", "patches/**", "tmp/**", "work/**"],
  "useTabs": false,
  "tabWidth": 2,
  "insertFinalNewline": true,
  "bracketSpacing": true,
}
