diff --git a/src/Makefile.shlib b/src/Makefile.shlib
index cd1543550ca5bf6815fa1fd205d40d427697de11..53b8a146c85fc7cb9622376c17dd4a1ed82ca7ef 100644
--- a/src/Makefile.shlib
+++ b/src/Makefile.shlib
@@ -238,6 +238,20 @@ ifeq ($(SHLIB_EXPORTS),)
   override CXXFLAGS += $(CXXFLAGS_SL_MODULE)
 endif
 
+ifeq ($(PORTNAME), emscripten)
+  LINK.shared       = $(COMPILER)
+  ifdef soname
+    # emscripten uses unversioned shared libraries
+    shlib     = $(shlib_bare)
+    soname    = $(shlib_bare)
+  endif
+  BUILD.exports     = ( $(AWK) '/^[^\#]/ {printf "%s\n",$$1}' $< ) | sort -u >$@
+#  BUILD.exports     = ( echo '{ global:'; $(AWK) '/^[^\#]/ {printf "%s;\n",$$1}' $<; echo ' local: *; };' ) >$@
+  exports_file      = $(SHLIB_EXPORTS:%.txt=%.list)
+#  ifneq (,$(exports_file))
+#    LINK.shared     += -Wl,--version-script=$(exports_file)
+#  endif
+endif
 
 ##
 ## BUILD
diff --git a/src/backend/Makefile b/src/backend/Makefile
index 162d3f1f2a982df04b31bcfea623d9770f2c6e9c..95467e013bfcff3b15428d644c49fa9f1530fc81 100644
--- a/src/backend/Makefile
+++ b/src/backend/Makefile
@@ -83,6 +83,7 @@ override LDFLAGS := $(LDFLAGS) $(LDFLAGS_EX) $(LDFLAGS_EX_BE)
 
 all: submake-libpgport submake-catalog-headers submake-utils-headers postgres $(POSTGRES_IMP)
 
+ifneq ($(PORTNAME), emscripten)
 ifneq ($(PORTNAME), cygwin)
 ifneq ($(PORTNAME), win32)
 ifneq ($(PORTNAME), aix)
@@ -93,6 +94,20 @@ postgres: $(OBJS)
 endif
 endif
 endif
+endif
+
+ifeq ($(PORTNAME), emscripten)
+
+postgres: $(OBJS)
+	$(CC) $(CFLAGS) $(call expand_subsys,$^) $(LDFLAGS) $(LIBS) -o $@$(X)
+
+# The backend the host embeds: postgres.js, postgres.wasm and postgres.data, linked into pgwasm/ so that they
+# stay apart from the postgres target's postgres.js and postgres.wasm.
+pgwasm: $(OBJS)
+	$(MKDIR_P) pgwasm
+	$(CC) $(CFLAGS) $(call expand_subsys,$^) $(LDFLAGS) $(LIBS) $(POSTGRES_PGWASM_FLAGS) -o pgwasm/postgres$(X)
+
+endif
 
 ifeq ($(PORTNAME), cygwin)
 
@@ -257,6 +272,15 @@ ifeq ($(MAKE_EXPORTS), true)
 	$(MKDIR_P) '$(DESTDIR)$(pgxsdir)/$(MKLDEXPORT_DIR)'
 endif
 
+ifeq ($(PORTNAME), emscripten)
+install-pgwasm:
+	$(MKDIR_P) '$(DESTDIR)$(prefix)/pgwasm'
+	$(INSTALL_PROGRAM) pgwasm/postgres.wasm '$(DESTDIR)$(prefix)/pgwasm/postgres.wasm'
+	$(INSTALL_PROGRAM) pgwasm/postgres.js '$(DESTDIR)$(prefix)/pgwasm/postgres.js'
+	$(INSTALL_PROGRAM) pgwasm/postgres.data '$(DESTDIR)$(prefix)/pgwasm/postgres.data'
+endif
+
+.PHONY: install-pgwasm
 
