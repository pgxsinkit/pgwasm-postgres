 	rm -f '$(DESTDIR)$(bindir)/initdb$(X)'
+ifeq ($(PORTNAME), emscripten)
+	rm -f $(addprefix '$(DESTDIR)$(bindir)'/, initdb.wasm)
+endif
 
 clean distclean:
 	rm -f initdb$(X) $(OBJS) localtime.c
 	rm -rf tmp_check
+ifeq ($(PORTNAME), emscripten)
+	rm -f initdb.wasm
+endif
 
 # ensure that changes in datadir propagate into object file
 initdb.o: initdb.c $(top_builddir)/src/Makefile.global
diff --git a/src/bin/pg_config/Makefile b/src/bin/pg_config/Makefile
index ce78a14d38f3738a9fb0567f73c7b0ba6c7a187c..4747d47e5c6ba807e962610241f6880e4cceddaf 100644
--- a/src/bin/pg_config/Makefile
+++ b/src/bin/pg_config/Makefile
@@ -24,18 +24,39 @@ all: pg_config
 pg_config: $(OBJS) | submake-libpgport
 	$(CC) $(CFLAGS) $(OBJS) $(LDFLAGS) $(LDFLAGS_EX) $(LIBS) -o $@$(X)
 
+# the emscripten build generates multiple "runnable" files (.cjs/.mjs + .wasm)
+# but other postgres tools expect exacly 'pg_config' as an executable 
+# we create a pg_config link to run_pg_cmd.mjs, which in turn calls pg_config.cjs/.mjs
+# pg_config.wasm is implicitly expected to be in the same folder
+
 install: all installdirs
 	$(INSTALL_SCRIPT) pg_config$(X) '$(DESTDIR)$(bindir)/pg_config$(X)'
+ifeq ($(PORTNAME), emscripten)
+	$(INSTALL_PROGRAM) pg_config.wasm '$(DESTDIR)$(bindir)/pg_config.wasm'
+	$(INSTALL_PROGRAM) pg_config$(X) '$(DESTDIR)$(bindir)/pg_config.mjs'
+	$(INSTALL_PROGRAM) $(top_srcdir)/pgwasm/scripts/run_pg_cmd.mjs '$(DESTDIR)$(bindir)/run_pg_cmd.mjs'
+	(cd '$(DESTDIR)$(bindir)' && ln -sf 'run_pg_cmd.mjs' 'pg_config')
+endif
 
 installdirs:
 	$(MKDIR_P) '$(DESTDIR)$(bindir)'
 
 uninstall:
 	rm -f '$(DESTDIR)$(bindir)/pg_config$(X)'
+ifeq ($(PORTNAME), emscripten)
+	rm -f '$(DESTDIR)$(bindir)/pg_config.wasm'
+	rm -f '$(DESTDIR)$(bindir)/pg_config.mjs'
+	rm -f '$(DESTDIR)$(bindir)/run_pg_cmd.mjs'
+	rm -f '$(DESTDIR)$(bindir)/pg_config'
+endif
 
 clean distclean:
 	rm -f pg_config$(X) $(OBJS)
 	rm -rf tmp_check
+ifeq ($(PORTNAME), emscripten)
+	rm -f pg_config.wasm
+	rm -f pg_config
+endif
 
 check:
 	$(prove_check)
