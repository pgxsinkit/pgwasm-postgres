diff --git a/src/bin/pg_config/Makefile b/src/bin/pg_config/Makefile
index 38169b0ded5b04e0d12e82cc39865e3d6703d5b6..df163ea5a007b319c6c4125526fecaa5462f2ad3 100644
--- a/src/bin/pg_config/Makefile
