+ifeq ($(PORTNAME), emscripten)
+	rm -f '$(DESTDIR)$(bindir)/pg_ctl.wasm'
+	rm -f '$(DESTDIR)$(bindir)/pg_ctl.mjs'
+	rm -f '$(DESTDIR)$(bindir)/pg_ctl'
+endif
 
