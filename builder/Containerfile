# pgwasm-postgres builder image (ADR-0001 decision 9).
#
# Began as a pinned rewrite of electricsql/pglite-builder:3.1.74-7, cut down to what the build ships. Electric built
# that image with BuildKit on 2026-06-01 from postgres-pglite 895b2954 (its pglite/builder/Dockerfile is identical to
# the one at b133782, the commit @electric-sql/pglite@0.5.8 pins). Its first revision (3.1.74-p1) was that image with
# every input pinned and verified, the dead URLs replaced and the build parallelism a parameter; built from it, the
# byte-identity build reproduced PGlite 0.5.8's artefacts byte for byte (ADR-0001 decision 2, 2026-09-27). 3.1.74-p2
# (18.3.0) built only what the core needs: zlib (--with-zlib), libxml2 (--with-libxml) and ICU (--with-icu).
#
# 6.0.10-p1 (18.6.1) moves the toolchain to the latest Emscripten and the libraries to their latest releases but ICU
# (ADR-0001 decisions 9 and 11, order of work 6): Emscripten 6.0.10 on Ubuntu 24.04 (the emsdk image's base), the
# apt snapshot of that release, zlib 1.3.2, libxml2 2.15.4 (from 2.14.5, built from its release tarball rather than
# a GitLab archive of the tag, so autogen.sh and with it autoconf, automake and libtool are gone), and ICU 76.1
# kept (see its pin). The steps, flags, install prefix (/install/libs) and source directory names of what it builds
# are otherwise 3.1.74-p2's: they reach the artefacts, since the libraries built here are linked into pglite.wasm.
#
# 6.0.13-p1 is the PostgreSQL 19 port's image: Emscripten 6.0.13 and ICU 79.1, the latest releases verified on
# 2026-10-24, with the Ubuntu snapshot advanced to that date. zlib 1.3.2 and libxml2 2.15.4 remain the latest.
# The port regenerates its minimal ICU data for 79.1 and declares a new dataFormat; ICU then stays fixed for
# the lifetime of this Postgres major.
#
# PINNING POLICY. The build's releases must be reproducible, so every input is pinned: the toolchain image by
# digest, apt by a dated snapshot, every source by checksum. The versions are the latest at the time of pinning
# (2026-10-24), except ICU, which moves only with a Postgres major (see its pin). A pin moves only as a deliberate
# C-build change, in a new image revision, released and gated like any other.
#
# MIRRORED SOURCES. Sources whose upstream URLs are not stable byte streams are fetched from this repository's
# release `builder-sources-<n>`; the upstream URL each one mirrors is in the comment above it, and the checksum is
# the upstream bytes', so a mirror cannot change them (ADR-0001, order of work 2b). An asset is never replaced in
# place: a further mirror goes into a new `builder-sources-<n>`.
#
# Build (amd64 only; JOBS changes speed, not output): `bun run builder:image`, which runs
#   podman build --format docker -t localhost/pgwasm-postgres-builder:6.0.13-p1 builder
# capped at 4 CPUs and 16 GiB, with builder/bin/make turning every bare `make -j` into `make -j4`.
# builder/dpkg-expected.txt is the runner stage's package set; the script checks it.
# Published by .github/workflows/builder-image.yml as ghcr.io/pgxsinkit/pgwasm-builder:6.0.13-p1;
# builder/image.lock.json records its digest and the content of this directory it was built from, and CI builds
# in it by digest. A change here is a new revision (-p2), never the published tag pushed again.

# PIN (toolchain): Emscripten 6.0.13, the latest release (emsdk's tags, 2026-10-24), by the digest of the
# linux/amd64 image of docker.io/emscripten/emsdk:6.0.13, verified with podman manifest inspect. Its arm64
# image has a different clang binary. Ubuntu 24.04 (noble) is its base. This file builds on amd64 only.
ARG EMSDK_IMAGE=docker.io/emscripten/emsdk:6.0.13@sha256:badbe38bedc8f4ff88a5a24672a2d59606015ba9a3bbe69801ad2fbdf75ab500

FROM ${EMSDK_IMAGE} AS toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# PIN (reproducibility): the Ubuntu archive as snapshot.ubuntu.com served it on 2026-10-24 (the latest snapshot
# when this revision was made), for noble, noble-updates, noble-backports and noble-security alike. Without it,
# `apt upgrade` and the packages below (bison and flex generate the parsers' C; the host gcc builds the native ICU
# tools and the regress client) would be whatever the archive serves on the day of the build. The base's sources
# are deb822 (/etc/apt/sources.list.d/ubuntu.sources).
ARG UBUNTU_SNAPSHOT=20261024T000000Z
RUN sed -i -E "s#http://(archive|security)\.ubuntu\.com/ubuntu/?#https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/#" /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y xz-utils pkgconf bison flex \
 && rm -rf /var/lib/apt/lists/*

FROM toolchain AS builder
ARG JOBS=4
RUN mkdir -p /install/libs
# -sWASM_BIGINT is gone: BigInt integration is Emscripten 6's default, and the setting is deprecated.
ENV EMCC_COMMON_FLAGS="-O2 -fPIC"

# Every source is fetched to a file, checked, then unpacked.

WORKDIR /src
# PIN (source): zlib 1.3.2, the latest release. zlib.net keeps only the current release at its top level;
# /fossils keeps every release.
# Mirror of https://www.zlib.net/fossils/zlib-1.3.2.tar.gz
RUN curl -fsSL -o /tmp/src.tgz https://github.com/pgxsinkit/pgwasm-postgres/releases/download/builder-sources-1/zlib-1.3.2.tar.gz \
 && echo "bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16  /tmp/src.tgz" | sha256sum -c - \
 && tar -xzf /tmp/src.tgz && rm /tmp/src.tgz
WORKDIR /src/zlib-1.3.2
RUN CFLAGS="${EMCC_COMMON_FLAGS}" CXXFLAGS="${EMCC_COMMON_FLAGS}" emconfigure ./configure --static --prefix=/install/libs
RUN emmake make -j"${JOBS}" && emmake make install

WORKDIR /src
# PIN (source): libxml2 2.15.4, the latest release, as its release tarball (configure generated upstream). The
# checksum is the one download.gnome.org publishes next to it (libxml2-2.15.4.sha256sum). Not mirrored: a release
# tarball is a stable byte stream, and download.gnome.org keeps every release, as ICU's GitHub release does.
RUN curl -fsSL -o /tmp/src.txz https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.4.tar.xz \
 && echo "98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821  /tmp/src.txz" | sha256sum -c - \
 && tar -xJf /tmp/src.txz && rm /tmp/src.txz
WORKDIR /src/libxml2-2.15.4
RUN CFLAGS="${EMCC_COMMON_FLAGS}" CXXFLAGS="${EMCC_COMMON_FLAGS}" emconfigure ./configure --enable-shared=no --enable-static=yes --with-python=no --prefix=/install/libs
RUN emmake make -j"${JOBS}" && emmake make install

# PIN (source): ICU 79.1, the latest release at the Postgres 19 port (2026-10-24; the checksum is the release's
# published SHASUM512.txt entry). ICU moves only with a Postgres major, never within one: a major already
# recreates every store through its dataFormat change, so no store ever lives across an ICU change, while inside a
# store's life an ICU upgrade would change the collation versions recorded in pg_collation and pg_database and could
# leave indexes on ICU collations silently wrong until reindexed. The overlay's minimal ICU data
# (pgwasm/static/minimal-icu/79.1) is regenerated in the same major's port. Keeping 79.1 for this major is the
# documented exception to the latest-versions rule once a newer ICU is published.
WORKDIR /src
RUN curl -fsSL -o /tmp/src.tgz https://github.com/unicode-org/icu/releases/download/release-79.1/icu4c-79.1-sources.tgz \
 && echo "9098adf9ba7fbe11d92963415cc80bf09de39ce1372414dbc2561e5f8ef57479a9fe4b6f7abc61911e4659e5953be987c459297d29e61b064d1931a16195a973  /tmp/src.tgz" | sha512sum -c - \
 && tar -xzf /tmp/src.tgz && rm /tmp/src.tgz

# Step 1: native ICU (the cross build needs its icupkg, gencnval, ...)
WORKDIR /src/icu/source
RUN mkdir /src/icu-native
RUN cd /src/icu-native && \
    /src/icu/source/configure --disable-shared --enable-static --disable-tests --disable-samples && \
    make -j"${JOBS}"

RUN mkdir -p /install/libs/share/icu/79.1/icudt79l/brkitr /install/libs/share/icu/79.1/icudt79l/coll /install/libs/share/icu/79.1/icudt79l/curr /install/libs/share/icu/79.1/icudt79l/lang /install/libs/share/icu/79.1/icudt79l/rbnf /install/libs/share/icu/79.1/icudt79l/region /install/libs/share/icu/79.1/icudt79l/translit /install/libs/share/icu/79.1/icudt79l/unit /install/libs/share/icu/79.1/icudt79l/zone

# Step 2: wasm ICU
# --with-data-packaging: https://unicode-org.github.io/icu/userguide/icu_data/#building-and-linking-against-icu-data
WORKDIR /src/icu-wasm
RUN CFLAGS="${EMCC_COMMON_FLAGS}" CXXFLAGS="${EMCC_COMMON_FLAGS} -std=c++17" \
    emconfigure /src/icu/source/configure \
    --host=wasm32-unknown-linux-gnu \
    --with-cross-build=/src/icu-native \
    --with-data-packaging=archive \
    --disable-shared \
    --enable-static \
    --disable-tests \
    --disable-samples \
    --disable-extras \
    --disable-icuio \
    --disable-layoutex \
    --prefix=/install/libs
RUN emmake make -j"${JOBS}" PKGDATA_OPTS="--without-assembly -O $(pwd)/data/icupkg.inc"
RUN emmake make install

FROM toolchain AS runner

# this is where the libraries will be installed and subsequently where the LIBS and INCLUDES can be found
ARG INSTALL_PREFIX=/install/libs
ENV INSTALL_PREFIX=${INSTALL_PREFIX}

COPY --from=builder /install/libs ${INSTALL_PREFIX}

# allow access to anyone
RUN chmod -R 777 /install

# Links the published image to this repository on GHCR (its package page and access). Metadata only: no layer, and
# so nothing a build sees, changes.
LABEL org.opencontainers.image.source="https://github.com/pgxsinkit/pgwasm-postgres"
